{
  "name": "diffbench",
  "version": "0.1.0",
  "description": "Falsifiable optimization gate for coding agents: hotspot profiling, differential equivalence fuzzing with counterexample shrinking, and statistical benchmarking.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "diffbench": "./dist/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "npm run build && npx tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "keywords": [
    "ai-agents",
    "agent-skills",
    "benchmarking",
    "differential-testing",
    "property-based-testing",
    "performance",
    "profiling",
    "welch-t-test",
    "typescript",
    "cli"
  ],
  "author": "md1qamar",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.0"
  }
}
